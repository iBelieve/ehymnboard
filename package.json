{
  "name": "ehymnboard",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dupes": "jscpd device tools web e2e scripts",
    "fallow": "fallow dead-code && fallow dupes --fail-on-issues",
    "health": "pnpm run health:static && pnpm run health:web && pnpm run health:emulator",
    "health:static": "fallow health --coverage-gaps && fallow health --complexity --workspace '!ehymnboard-web' --workspace '!ehymnboard-emulator'",
    "health:web": "fallow health --complexity --workspace ehymnboard-web --coverage web/coverage",
    "health:emulator": "fallow health --complexity --workspace ehymnboard-emulator --coverage device/emulator/coverage",
    "check-new-deps": "node scripts/src/check-new-deps.ts"
  },
  "packageManager": "pnpm@12.21.0",
  "devDependencies": {
    "fallow": "3.48.0",
    "fallow-type-aware": "3.48.0",
    "jscpd": "5.4.3",
    "npm-check-updates": "23.1.1",
    "oxlint": "catalog:",
    "prettier": "3.10.1"
  }
}
