{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Also the Cloudflare Worker's name: Workers Builds deploys master to it, the
  // production server at https://hymnboard.sonrise.io (and
  // https://hymnboard.sonrise.workers.dev; see README.md). The build writes
  // dist/hymnboard/, which selfhost/generate-config.mjs reads.
  "name": "hymnboard",
  "main": "src/worker/index.ts",
  // Keep at or below the date the pinned workerd supports; the self-hosted
  // Docker image reads it from the build output.
  "compatibility_date": "2026-11-15",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Everything goes through the Worker first, so the API's routes always win.
    "run_worker_first": true,
  },
  "durable_objects": {
    "bindings": [
      { "name": "HYMN_BOARD", "class_name": "HymnBoard" },
      { "name": "ACCOUNTS", "class_name": "Accounts" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["HymnBoard"] },
    { "tag": "v2", "new_sqlite_classes": ["Accounts"] },
  ],
  // Which deploy is running: the Durable Object closes boards' sockets from an
  // earlier one, whose ping times Cloudflare stops keeping (see hymn-board.ts)
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true },
    "issues": { "enabled": true },
  },
  // This deploy is production (the boards' server, hymnboard.sonrise.io), so
  // it pings the boards' healthchecks.io checks. Previews don't inherit it.
  "vars": { "HEALTHCHECKS": "on" },
  "workers_dev": true,
  // Gives each Worker Preview (below) a URL,
  // https://<branch>-hymnboard.sonrise.workers.dev. (Durable Object Workers
  // get no version preview URLs, so this enables nothing else.)
  "preview_urls": true,
  // Worker Previews: Workers Builds deploys each non-master branch to its own
  // URL with its own, empty Durable Object. Previews don't inherit bindings or
  // vars, so the binding is repeated here, and with no HEALTHCHECKS var they
  // never ping healthchecks.io. Observability is spelled out too, so previews
  // keep traces and Issues whatever the dashboard's Previews base says. Their secrets
  // (BETTER_AUTH_SECRET, SETUP_PASSWORD) are set with
  // `wrangler preview base-config secret put` (see README.md).
  "previews": {
    // Lets the e2e tests' emulated board connect to a preview's /ws
    "vars": { "EXTRA_DEVICE_IDS": "0000000000000000" },
    "durable_objects": {
      "bindings": [
        { "name": "HYMN_BOARD", "class_name": "HymnBoard" },
        { "name": "ACCOUNTS", "class_name": "Accounts" },
      ],
    },
    "version_metadata": { "binding": "CF_VERSION_METADATA" },
    "observability": {
      "enabled": true,
      "traces": { "enabled": true },
      "issues": { "enabled": true },
    },
  },
}
