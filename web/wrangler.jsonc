{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Also the Cloudflare Worker's name: Workers Builds deploys master to
  // https://hymnboard.sonrise.workers.dev (see README.md). The build writes
  // dist/hymnboard/, which selfhost/generate-config.mjs reads.
  "name": "hymnboard",
  "main": "src/worker/index.ts",
  // Keep at or below the date the pinned workerd supports; the self-hosted
  // Docker image reads it from the build output.
  "compatibility_date": "2026-11-15",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Everything goes through the Worker first so basic auth covers the admin.
    "run_worker_first": true,
  },
  "durable_objects": {
    "bindings": [{ "name": "HYMN_BOARD", "class_name": "HymnBoard" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HymnBoard"] }],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true },
    "issues": { "enabled": true },
  },
  // No HEALTHCHECKS var here: only the self-hosted image (prod) pings
  // healthchecks.io, so the Cloudflare deploy can't touch the boards' checks.
  // Set "vars": { "HEALTHCHECKS": "on" } when Cloudflare becomes prod.
  "workers_dev": true,
  // Gives each Worker Preview (below) a URL,
  // https://<branch>-hymnboard.sonrise.workers.dev. (Durable Object Workers
  // get no version preview URLs, so this enables nothing else.)
  "preview_urls": true,
  // Worker Previews: Workers Builds deploys each non-master branch to its own
  // URL with its own, empty Durable Object. Previews inherit nothing from the
  // settings above, so the binding is repeated here, and with no HEALTHCHECKS
  // var they never ping healthchecks.io. Their basic-auth secrets are set
  // with `wrangler preview base-config secret put` (see README.md).
  "previews": {
    "durable_objects": {
      "bindings": [{ "name": "HYMN_BOARD", "class_name": "HymnBoard" }],
    },
    "observability": {
      "enabled": true,
      "traces": { "enabled": true },
      "issues": { "enabled": true },
    },
  },
}
