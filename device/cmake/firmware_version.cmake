# Writes the firmware version (the short commit hash, plus "-dirty" and a
# timestamp for uncommitted changes) to a header and a text file. Tags are
# left out: the repo's releases/YYYY-MM-DD tags would add a '/' and push the
# version past the length limit. Runs on every build so the version always
# matches the image that was built; the outputs are only touched when the
# version changes.
#
# Inputs: SOURCE_DIR, OUTPUT_HEADER, OUTPUT_TEXT

execute_process(
    COMMAND git describe --always --dirty --exclude=*
    WORKING_DIRECTORY ${SOURCE_DIR}
    OUTPUT_VARIABLE FIRMWARE_VERSION
    OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_QUIET
    RESULT_VARIABLE GIT_RESULT
)

if(NOT GIT_RESULT EQUAL 0 OR FIRMWARE_VERSION STREQUAL "")
    set(FIRMWARE_VERSION "unknown")
endif()

# Two builds from the same dirty tree must not share a version, or the server
# would consider a board already up to date
if(FIRMWARE_VERSION MATCHES "-dirty$")
    string(TIMESTAMP BUILD_TIME "%Y%m%d%H%M%S" UTC)
    set(FIRMWARE_VERSION "${FIRMWARE_VERSION}-${BUILD_TIME}")
endif()

# Must fit in SavedState::ota_*_version (and match the server's limit)
string(LENGTH "${FIRMWARE_VERSION}" FIRMWARE_VERSION_LENGTH)
if(FIRMWARE_VERSION_LENGTH GREATER 47)
    message(FATAL_ERROR "Firmware version '${FIRMWARE_VERSION}' is longer than 47 characters")
endif()

file(WRITE ${OUTPUT_HEADER}.tmp
    "#pragma once\n\n// Generated by cmake/firmware_version.cmake, do not edit\n#define FIRMWARE_VERSION \"${FIRMWARE_VERSION}\"\n")
file(WRITE ${OUTPUT_TEXT}.tmp "${FIRMWARE_VERSION}\n")

execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different ${OUTPUT_HEADER}.tmp ${OUTPUT_HEADER})
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different ${OUTPUT_TEXT}.tmp ${OUTPUT_TEXT})
file(REMOVE ${OUTPUT_HEADER}.tmp ${OUTPUT_TEXT}.tmp)
