# web/Dockerfile builds from the repository root, where the workspace's
# lockfile is, so send it only the workspace's root files and web/.
*
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!tsconfig.base.json
!web/
**/node_modules
web/dist
web/.wrangler
web/*.log
# Local secrets: the Vite plugin would copy .dev.vars into dist/.
web/.dev.vars*
web/.env*
