// Fallow (https://fallow.tools): unused files, exports and dependencies,
// import cycles and duplicated code (`pnpm run fallow`), and complexity,
// CRAP scores and coverage gaps (`pnpm run health`), over the TypeScript in
// the pnpm workspace. The firmware's C++ has its own checks (lizard,
// tools/crap.py, clang-tidy).
{
  "$schema": "./node_modules/fallow/schema.json",
  // With the TypeScript checker (fallow-type-aware), so a use through a typed
  // value counts, such as a Durable Object's RPC methods called on its stub or
  // a method called on `emu.server.sockets[0]`.
  "typeAware": { "enabled": true },
  "entry": [
    // The static-assets Worker that the self-hosted image's workerd config
    // (web/selfhost/generate-config.mjs) loads.
    "web/selfhost/assets.js",
  ],
  "supportEntry": [
    // Writes that config; web/Dockerfile runs it.
    "web/selfhost/generate-config.mjs",
  ],
  "ignoreDependencies": [
    // The Docker image copies workerd's binary out of the package
    // (web/Dockerfile); nothing imports it.
    "workerd",
    // e2e imports the emulator's source by relative path. The dependency is
    // there so a filtered install (--filter ehymnboard-e2e...) brings the
    // emulator's own dependencies too.
    "ehymnboard-emulator",
  ],
  "duplicates": {
    // Generated by `wrangler types`.
    "ignore": ["web/worker-configuration.d.ts"],
  },
  "overrides": [
    {
      // Vitest never measures the coverage of its own test and setup files,
      // so their CRAP scores would be guesses. Their complexity still counts.
      "files": ["web/test/**"],
      "rules": { "complexity-crap": "off" },
    },
  ],
  "rules": {
    "unused-dev-dependencies": "error",
    "unused-optional-dependencies": "error",
    "coverage-gaps": "error",
    "require-suppression-reason": "error",
    "private-type-leaks": "error",
  },
}
