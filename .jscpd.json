{
  "threshold": 0,
  "minTokens": 50,
  "mode": "weak",
  "reporters": ["console"],
  "gitignore": true,
  "ignore": [
    "**/build*/**",
    "**/node_modules/**",
    "**/.venv/**",
    "**/*.lock",
    "**/package-lock.json",
    "**/pnpm-lock.yaml",
    "**/static/**",
    "**/*.svg",
    "device/lib/**",
    "web/dist/**",
    "**/.wrangler/**",
    "web/test/fixtures/**",
    "web/worker-configuration.d.ts"
  ],
  "absolute": false
}
